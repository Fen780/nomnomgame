
flowchart LR
    Input["Ввод: ← → / A D / мышь / Esc / R / M / клик"]
    Scene["GameScene<br/>главная сцена и игровой цикл"]
    Player["Игрок<br/>кот / демон / призрак"]
    Items["Падающие объекты<br/>еда, мусор, бомба, звезда, магнит, щит"]
    Spawner["Появление объектов<br/>spawnItem / pickItem"]
    Collision["Столкновения и пропуски<br/>moveItems / onCatch / onFoodMissed"]
    Combo["Комбо<br/>множитель очков за серию,<br/>до ×5"]
    State["Состояние игры<br/>счёт, комбо, жизни, щит, время,<br/>пауза, рекорд (localStorage), поражение"]
    Phases["Система фаз<br/>фаза 1 → 2 при 20 очках → 3 при 60 очках"]
    Difficulty["Сложность<br/>скорость падения и частота появления"]
    Sounds["Звук<br/>WebAudio, без ассетов, вкл/выкл по M"]
    UI["Интерфейс<br/>счёт, комбо, сердца, предупреждения,<br/>пауза, конец игры с рекордом"]
    Config["Настройки<br/>GAME_CONFIG"]

    Input -->|"команды управления"| Scene
    Scene -->|"двигает"| Player
    Scene -->|"вызывает по таймеру"| Spawner
    Spawner -->|"создаёт"| Items
    Scene -->|"обновляет движение и проверяет"| Collision
    Player -->|"позиция"| Collision
    Items -->|"позиция и тип"| Collision
    Collision -->|"серия уловов"| Combo
    Combo -->|"множитель"| Collision
    Collision -->|"изменяет счёт и жизни"| State
    Scene -->|"отслеживает время"| Difficulty
    Difficulty -->|"задаёт интервал"| Spawner
    Difficulty -->|"задаёт скорость"| Items
    State -->|"счёт определяет переход"| Phases
    Phases -->|"меняет набор предметов"| Spawner
    Phases -->|"меняет облик"| Player
    State -->|"пауза / конец игры"| Scene
    State -->|"события игры"| Sounds
    Scene -->|"обновляет отображение"| UI
    State -->|"счёт, комбо, жизни и рекорд"| UI
    Phases -->|"фон, сердца и предупреждение"| UI
    Config -->|"параметры"| Scene
    Config -->|"вероятности предметов"| Spawner
    Config -->|"шаг и кап комбо"| Combo
    Config -->|"пороги"| Phases
    Config -->|"скорости и интервалы"| Difficulty
    Config -->|"тексты и оформление"| UI

    classDef main fill:#18181f,color:#fff,stroke:#18181f,stroke-width:2px
    classDef highlight fill:#ffb72e,color:#161616,stroke:#9a6100,stroke-width:2px
    classDef normal fill:#f6f4ed,color:#262626,stroke:#aaa69c,stroke-width:1px
    class Scene main
    class Phases,Config,Combo highlight
    class Input,Player,Items,Spawner,Collision,State,Difficulty,Sounds,UI normal
